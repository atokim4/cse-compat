# Where the server listens.
PORT=8080
HOST=127.0.0.1

# Base URL clients use, without a trailing slash. Shown in the OpenSearch template and the
# discovery document. Leave empty to take it from each request.
PUBLIC_BASE_URL=

# Comma-separated API keys clients must send as ?key= or X-Goog-Api-Key. Empty = no key required.
CSE_API_KEYS=

# Queries per key per day, reset at midnight America/Los_Angeles. 0 = unlimited.
CSE_DAILY_QUOTA=0

# Optional JSON file mapping cx -> engine (title, sites, excludeSites, backend).
# Without it any cx is accepted and searches everything. See examples/engines.sample.json.
CSE_ENGINES_FILE=
CSE_ENGINE_TITLE=cse-compat

# 1 = reject parameters the backend cannot honour instead of ignoring them.
CSE_STRICT=0

# Default backend: corpus | searxng | brave. Every backend whose settings below are filled in is
# available, and an engine in CSE_ENGINES_FILE can pick one with "backend".
CSE_BACKEND=corpus

# corpus = a local JSON file of documents (offline, deterministic, for CI).
CSE_CORPUS_FILE=examples/sample-corpus.json

# SearXNG instance (its settings.yml must list json in search.formats; see deploy/searxng/settings.yml).
SEARXNG_URL=
# How long a stitched result list is reused for the next pages of the same query (ms).
SEARXNG_CACHE_TTL_MS=600000

# Brave Search API key, sent as X-Subscription-Token. Each upstream request is billed by Brave.
BRAVE_API_KEY=
BRAVE_BASE_URL=
# 0 = no caching. Turn it on only if your Brave plan allows storing results.
BRAVE_CACHE_TTL_MS=0

BACKEND_TIMEOUT_MS=8000
