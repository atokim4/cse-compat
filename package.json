{
  "name": "cse-compat",
  "version": "0.1.0",
  "description": "Self-hosted server that speaks the Google Custom Search JSON API v1 wire format, backed by SearXNG or Brave Search.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:clients": "python3 -I tests/clients/run_clients.py",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
